# ============================================================================
# Shopify — three separate credentials, three different jobs
# ============================================================================

# --- 1. Storefront API (the frontend's token) --------------------------------
# 32-character hex string. This is the "public access token" / Storefront API
# access token. It is PUBLIC BY DESIGN — it ships inside your browser bundle,
# which is why it is safe to put in a frontend env var. It can only read
# published products and write carts.
#
# CURRENT CORRECT VALUE (PawGrip store, bkhvxg-d7.myshopify.com):
#   4c7f63ac8ebcfac2184ac2bddad85cb7
# (The old vynils-galor token 055c1ac1… is retired — do not restore it.)
#
# WARNING: never replace this with an shpat_ token. Admin API tokens are
# rejected by the Storefront API with 401, which breaks every product query
# on the site. The two token formats are NOT interchangeable.
#
# To read live inventory (powers the "Only X left" message) the issuing app
# also needs the Storefront scope: unauthenticated_read_product_inventory
VITE_SHOPIFY_STOREFRONT_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=32-char-hex-public-access-token

# --- 2. Admin API — Dev Dashboard app (the seeder's credentials) -------------
# Used ONLY by scripts/shopify-seed.mjs to create products. Exchanged for a
# short-lived 24h token automatically; nothing long-lived is stored.
# Client ID is ~32 chars, client secret starts with shpss_.
# Required scopes: write_products, write_inventory, write_publications,
# write_locations (plus read_products if you want idempotency to also detect
# products created outside this script).
# Bundle discount setup requires write_discounts. read_discounts also enables
# inspection and reconciliation of existing discount codes.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# --- 3. Admin API — static token (optional alternative) ---------------------
# A classic custom app's Admin API access token, starts with shpat_.
# Use this instead of 2) only if you prefer a static token.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# ============================================================================
# Analytics — REQUIRED before running paid traffic
# ============================================================================
# These are still placeholders. Replace them or conversion tracking and
# PMax bidding will silently record nothing.
VITE_GA_MEASUREMENT_ID=
VITE_GOOGLE_ADS_CONVERSION_ID=
VITE_META_PIXEL_ID=
# Microsoft Advertising (Bing) UET tag ID — loaded by initAnalytics() from
# the build env, same as the tags above. On this account the UET tag alone
# activates Microsoft Clarity (confirmed on the Clarity dashboard on
# 2026-10-13), so no separate clarity.ms tag is wired; if that ever
# changes, add the Clarity project ID here the same way.
VITE_MICROSOFT_UET_TAG_ID=

# ============================================================================
# Business-identity enforcement switch
# ============================================================================
# Leave EMPTY (or unset) while the BUSINESS object in src/lib/assets.ts still
# contains REPLACE_ placeholders — the storefront then shows a developer
# notice banner and the build passes.
#
# Set to 'true' ONLY once the real address/phone are in place. With the flag
# ON and any placeholder remaining, `vite.config.ts` fails the build (so the
# deploy pipeline cannot ship a site Merchant Center / Ads would reject) and
# the Footer throws a loud render error. See LAUNCH_BLOCKERS.md #1 and
# DEPLOYMENT.md.
VITE_REQUIRE_BUSINESS_INFO=
# PawGrip Pro — Apache configuration for the domain.com (cPanel) subdomain.
# This file lives in public/ so Vite copies it into dist/ and it deploys with
# the site. It translates netlify.toml (now retired) into Apache directives:
#   1. SPA catch-all rewrite  -> /index.html, but never shadowing a real file
#   2. Security headers       -> the same five headers Netlify sent
#   3. Hashed-asset caching   -> long cache for /assets/, revalidate index.html
# It is inert on any host that is not Apache (Netlify ignores it).

# ---------------------------------------------------------------------------
# 1. SPA catch-all
# ---------------------------------------------------------------------------
# Apache checks the real file/directory first, exactly like Netlify did: the
# static policy pages (/shipping/, /about/, /contact/, the guide) and the
# hashed assets are served as files, and only unknown paths fall through to
# index.html.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# ---------------------------------------------------------------------------
# 2. Security headers (mirrors the [[headers]] block in netlify.toml)
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ---------------------------------------------------------------------------
# 3. Caching
# ---------------------------------------------------------------------------
# Long-cache the hashed build assets (their filenames change every build);
# index.html must always revalidate so deploys take effect immediately.
<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "\.(js|css|woff2?|svg|png|jpe?g|webp|gif|ico|map)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|svg|png|jpe?g|webp|gif|ico|map)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

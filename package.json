{
  "name": "pet-ramp-store",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings src scripts vite.config.ts",
    "preview": "vite preview",
    "shopify:seed": "node scripts/shopify-seed.mjs",
    "shopify:seed:dry": "node scripts/shopify-seed.mjs --dry-run",
    "shopify:verify": "node scripts/shopify-seed.mjs --verify",
    "shopify:purge": "node scripts/shopify-seed.mjs --purge",
    "shopify:discounts:dry": "node scripts/shopify-bundle-discounts.mjs --dry-run",
    "shopify:discounts:apply": "node scripts/shopify-bundle-discounts.mjs --apply",
    "shopify:images:dry": "node scripts/shopify-product-images.mjs",
    "shopify:images:apply": "node scripts/shopify-product-images.mjs --apply"
  },
  "dependencies": {
    "lucide-react": "^1.55.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
